page {
  min-height: 100vh;
  background: #eef7f6;
  color: #132b33;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
}

.page-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 36rpx 30rpx 56rpx;
  background:
    linear-gradient(180deg, rgba(62, 177, 169, .18) 0%, rgba(238, 247, 246, 0) 420rpx),
    #eef7f6;
}

.history-hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 34rpx 8rpx 24rpx;
}

.eyebrow {
  align-self: flex-start;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(44, 139, 132, .12);
  color: #24746d;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.3;
}

.title {
  display: block;
  margin-top: 18rpx;
  color: #102f35;
  font-size: 46rpx;
  font-weight: 800;
  line-height: 1.16;
}

.subtitle {
  display: block;
  margin-top: 12rpx;
  color: #58747a;
  font-size: 26rpx;
  line-height: 1.5;
}

.clear-button {
  flex-shrink: 0;
  width: 116rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 18rpx;
  background: #e8f1f0;
  color: #24535a;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 64rpx;
}

.clear-button::after {
  border: 0;
}

.summary-card,
.history-card {
  border: 1rpx solid rgba(86, 134, 142, .14);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, .92);
  box-shadow: 0 18rpx 46rpx rgba(26, 77, 86, .08);
}

.summary-card {
  margin-top: 8rpx;
  padding: 28rpx;
}

.summary-head,
.history-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.summary-title,
.history-title {
  color: #18383f;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.3;
}

.summary-subtitle,
.history-count {
  color: #7d9297;
  font-size: 23rpx;
  line-height: 1.3;
}

.summary-grid {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
}

.summary-item {
  width: 31.5%;
  box-sizing: border-box;
  padding: 20rpx 12rpx;
  border-radius: 20rpx;
  background: #f5fbfa;
  text-align: center;
}

.summary-number {
  display: block;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.1;
}

.summary-number.normal {
  color: #10846d;
}

.summary-number.fall {
  color: #ba2636;
}

.summary-number.sitting {
  color: #96600a;
}

.summary-label {
  display: block;
  margin-top: 8rpx;
  color: #6a858c;
  font-size: 23rpx;
  line-height: 1.3;
}

.summary-alert {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #f7faf9;
}

.summary-alert-label {
  flex-shrink: 0;
  color: #6a858c;
  font-size: 23rpx;
  line-height: 1.3;
}

.summary-alert-value {
  margin-left: 18rpx;
  color: #18383f;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
  text-align: right;
}

.ai-card {
  margin-top: 28rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(86, 134, 142, .14);
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 46rpx rgba(26, 77, 86, .08);
}

.ai-card.normal {
  background: linear-gradient(145deg, #ffffff 0%, #effbf7 100%);
}

.ai-card.sitting {
  background: linear-gradient(145deg, #ffffff 0%, #fff7e4 100%);
}

.ai-card.fall {
  background: linear-gradient(145deg, #ffffff 0%, #fff0f0 100%);
}

.ai-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.ai-title {
  display: block;
  color: #18383f;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.3;
}

.ai-subtitle {
  display: block;
  max-width: 420rpx;
  margin-top: 8rpx;
  color: #6a858c;
  font-size: 22rpx;
  line-height: 1.35;
}

.ai-score {
  flex-shrink: 0;
  min-width: 112rpx;
  height: 76rpx;
  padding: 0 12rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.ai-score.normal {
  background: #e0f7ef;
  color: #10846d;
}

.ai-score.sitting {
  background: #fff0cf;
  color: #96600a;
}

.ai-score.fall {
  background: #ffe2e3;
  color: #ba2636;
}

.ai-score-num {
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1;
}

.ai-score-unit {
  margin-left: 4rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.ai-track {
  height: 18rpx;
  margin-top: 24rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #dce9e8;
}

.ai-fill {
  height: 100%;
  border-radius: 999rpx;
}

.ai-fill.normal {
  background: linear-gradient(90deg, #35c59a, #29a6c7);
}

.ai-fill.sitting {
  background: linear-gradient(90deg, #ffd166, #f59b2f);
}

.ai-fill.fall {
  background: linear-gradient(90deg, #ff8177, #de3f4f);
}

.ai-reason {
  display: block;
  margin-top: 22rpx;
  color: #18383f;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.45;
}

.ai-advice {
  display: block;
  margin-top: 14rpx;
  color: #58747a;
  font-size: 25rpx;
  line-height: 1.55;
}

.history-card {
  margin-top: 28rpx;
  padding: 28rpx;
}

.history-empty {
  padding: 26rpx 0 4rpx;
  color: #7d9297;
  font-size: 25rpx;
  line-height: 1.4;
}

.history-item {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(86, 134, 142, .12);
}

.history-item:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.history-dot {
  flex-shrink: 0;
  width: 18rpx;
  height: 18rpx;
  margin-top: 10rpx;
  border-radius: 50%;
  background: #9aa8b5;
}

.history-dot.normal {
  background: #24b989;
}

.history-dot.sitting {
  background: #f0a52d;
}

.history-dot.fall {
  background: #de3f4f;
}

.history-copy {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.history-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.history-status {
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.3;
}

.history-status.normal {
  color: #10846d;
}

.history-status.sitting {
  color: #96600a;
}

.history-status.fall {
  color: #ba2636;
}

.history-status.unknown {
  color: #53606b;
}

.history-time {
  flex-shrink: 0;
  margin-left: 14rpx;
  color: #7d9297;
  font-size: 22rpx;
  line-height: 1.3;
}

.history-detail {
  display: block;
  margin-top: 8rpx;
  color: #58747a;
  font-size: 24rpx;
  line-height: 1.4;
}
