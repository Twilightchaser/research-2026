page {
  min-height: 100vh;
  background: #eef7f6;
  color: #132b33;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
}

.page-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 36rpx 30rpx 56rpx;
  background:
    linear-gradient(180deg, rgba(62, 177, 169, .18) 0%, rgba(238, 247, 246, 0) 420rpx),
    #eef7f6;
}

.hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 34rpx 8rpx 24rpx;
}

.hero-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.eyebrow {
  align-self: flex-start;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(44, 139, 132, .12);
  color: #24746d;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.3;
}

.title {
  margin-top: 18rpx;
  color: #102f35;
  font-size: 46rpx;
  font-weight: 800;
  line-height: 1.16;
}

.subtitle {
  margin-top: 12rpx;
  color: #58747a;
  font-size: 26rpx;
  line-height: 1.5;
}

.hero-badge {
  flex-shrink: 0;
  width: 148rpx;
  height: 148rpx;
  border-radius: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 18rpx 42rpx rgba(32, 86, 94, .14);
}

.hero-badge.normal {
  background: linear-gradient(145deg, #38cfa8, #159d8d);
  color: #ffffff;
}

.hero-badge.sitting {
  background: linear-gradient(145deg, #ffd36d, #f59b2f);
  color: #3d2600;
}

.hero-badge.fall {
  background: linear-gradient(145deg, #ff7a79, #de3f4f);
  color: #ffffff;
}

.hero-badge.unknown {
  background: linear-gradient(145deg, #9aa8b5, #65717c);
  color: #ffffff;
}

.badge-icon {
  font-size: 46rpx;
  line-height: 1;
}

.badge-text {
  margin-top: 12rpx;
  max-width: 120rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.2;
}

.time-card,
.status-panel,
.care-card,
.summary-card,
.history-card,
.device-list {
  border: 1rpx solid rgba(86, 134, 142, .14);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, .92);
  box-shadow: 0 18rpx 46rpx rgba(26, 77, 86, .08);
}

.time-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
  padding: 24rpx 28rpx;
}

.time-label,
.metric-label,
.device-desc {
  color: #6a858c;
  font-size: 24rpx;
  line-height: 1.4;
}

.time-value {
  display: block;
  margin-top: 6rpx;
  color: #17363d;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
}

.pulse-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: #24b989;
  box-shadow: 0 0 0 12rpx rgba(36, 185, 137, .14);
}

.status-panel {
  margin-top: 26rpx;
  padding: 34rpx 30rpx 30rpx;
}

.status-panel.normal {
  background: linear-gradient(145deg, #ffffff 0%, #effbf7 100%);
}

.status-panel.sitting {
  background: linear-gradient(145deg, #ffffff 0%, #fff7e4 100%);
}

.status-panel.fall {
  background: linear-gradient(145deg, #ffffff 0%, #fff0f0 100%);
}

.status-main {
  display: flex;
  align-items: center;
}

.status-icon {
  flex-shrink: 0;
  width: 108rpx;
  height: 108rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e7f4f3;
  font-size: 54rpx;
  line-height: 1;
}

.status-copy {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.status-title {
  color: #122f35;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.2;
}

.status-desc {
  margin-top: 10rpx;
  color: #58747a;
  font-size: 27rpx;
  line-height: 1.45;
}

.status-meter {
  margin-top: 30rpx;
}

.meter-track {
  height: 16rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #dce9e8;
}

.meter-fill {
  height: 100%;
  border-radius: 999rpx;
}

.meter-fill.normal {
  width: 34%;
  background: linear-gradient(90deg, #35c59a, #29a6c7);
}

.meter-fill.sitting {
  width: 66%;
  background: linear-gradient(90deg, #ffd166, #f59b2f);
}

.meter-fill.fall {
  width: 96%;
  background: linear-gradient(90deg, #ff8177, #de3f4f);
}

.meter-fill.unknown {
  width: 48%;
  background: linear-gradient(90deg, #9aa8b5, #65717c);
}

.meter-text {
  display: block;
  margin-top: 12rpx;
  color: #526d73;
  font-size: 24rpx;
  line-height: 1.4;
}

.ai-card {
  margin-top: 26rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(86, 134, 142, .14);
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 46rpx rgba(26, 77, 86, .08);
}

.ai-card.normal {
  background: linear-gradient(145deg, #ffffff 0%, #effbf7 100%);
}

.ai-card.sitting {
  background: linear-gradient(145deg, #ffffff 0%, #fff7e4 100%);
}

.ai-card.fall {
  background: linear-gradient(145deg, #ffffff 0%, #fff0f0 100%);
}

.ai-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.ai-title {
  display: block;
  color: #18383f;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.3;
}

.ai-subtitle {
  display: block;
  max-width: 420rpx;
  margin-top: 8rpx;
  color: #6a858c;
  font-size: 22rpx;
  line-height: 1.35;
}

.ai-score {
  flex-shrink: 0;
  min-width: 112rpx;
  height: 76rpx;
  padding: 0 12rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.ai-score.normal {
  background: #e0f7ef;
  color: #10846d;
}

.ai-score.sitting {
  background: #fff0cf;
  color: #96600a;
}

.ai-score.fall {
  background: #ffe2e3;
  color: #ba2636;
}

.ai-score-num {
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1;
}

.ai-score-unit {
  margin-left: 4rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.ai-track {
  height: 18rpx;
  margin-top: 24rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #dce9e8;
}

.ai-fill {
  height: 100%;
  border-radius: 999rpx;
}

.ai-fill.normal {
  background: linear-gradient(90deg, #35c59a, #29a6c7);
}

.ai-fill.sitting {
  background: linear-gradient(90deg, #ffd166, #f59b2f);
}

.ai-fill.fall {
  background: linear-gradient(90deg, #ff8177, #de3f4f);
}

.ai-result {
  display: flex;
  align-items: flex-start;
  margin-top: 22rpx;
}

.ai-level {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.2;
}

.ai-level.normal {
  background: #e0f7ef;
  color: #10846d;
}

.ai-level.sitting {
  background: #fff0cf;
  color: #96600a;
}

.ai-level.fall {
  background: #ffe2e3;
  color: #ba2636;
}

.ai-reason {
  margin-left: 16rpx;
  color: #18383f;
  font-size: 25rpx;
  line-height: 1.45;
}

.ai-advice {
  display: block;
  margin-top: 18rpx;
  color: #58747a;
  font-size: 25rpx;
  line-height: 1.55;
}

.section-title {
  margin: 34rpx 4rpx 18rpx;
  color: #18383f;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.2;
}

.metric-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 26rpx;
}

.metric-card {
  width: 48.6%;
  min-height: 176rpx;
  box-sizing: border-box;
  margin-bottom: 18rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(86, 134, 142, .14);
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 34rpx rgba(26, 77, 86, .07);
}

.metric-card.primary {
  background: linear-gradient(145deg, #174a51 0%, #247b73 100%);
}

.metric-card.primary .metric-label,
.metric-card.primary .metric-note {
  color: rgba(255, 255, 255, .72);
}

.metric-card.primary .metric-value {
  color: #ffffff;
}

.metric-value {
  display: block;
  margin-top: 14rpx;
  color: #17363d;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.15;
}

.metric-unit {
  font-size: 24rpx;
  font-weight: 600;
}

.metric-note {
  display: block;
  margin-top: 12rpx;
  color: #7d9297;
  font-size: 22rpx;
  line-height: 1.35;
}

.history-card {
  margin-top: 28rpx;
  padding: 28rpx;
}

.summary-card {
  margin-top: 28rpx;
  padding: 28rpx;
}

.summary-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.summary-title {
  color: #18383f;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.3;
}

.summary-subtitle {
  color: #7d9297;
  font-size: 22rpx;
  line-height: 1.3;
}

.summary-grid {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
}

.summary-item {
  width: 31.5%;
  box-sizing: border-box;
  padding: 20rpx 12rpx;
  border-radius: 20rpx;
  background: #f5fbfa;
  text-align: center;
}

.summary-number {
  display: block;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.1;
}

.summary-number.normal {
  color: #10846d;
}

.summary-number.fall {
  color: #ba2636;
}

.summary-number.sitting {
  color: #96600a;
}

.summary-label {
  display: block;
  margin-top: 8rpx;
  color: #6a858c;
  font-size: 23rpx;
  line-height: 1.3;
}

.summary-alert {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #f7faf9;
}

.summary-alert-label {
  flex-shrink: 0;
  color: #6a858c;
  font-size: 23rpx;
  line-height: 1.3;
}

.summary-alert-value {
  margin-left: 18rpx;
  color: #18383f;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
  text-align: right;
}

.action-row {
  display: flex;
  gap: 18rpx;
  margin-top: 22rpx;
}

.action-button {
  flex: 1;
  height: 76rpx;
  padding: 0;
  border: 0;
  border-radius: 18rpx;
  background: #e8f1f0;
  color: #24535a;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 76rpx;
}

.action-button::after {
  border: 0;
}

.action-button.primary {
  background: #174a51;
  color: #ffffff;
}

.history-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.history-title {
  color: #18383f;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.3;
}

.history-count {
  color: #6a858c;
  font-size: 23rpx;
  line-height: 1.3;
}

.history-empty {
  padding: 26rpx 0 4rpx;
  color: #7d9297;
  font-size: 25rpx;
  line-height: 1.4;
}

.history-item {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(86, 134, 142, .12);
}

.history-item:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.history-dot {
  flex-shrink: 0;
  width: 18rpx;
  height: 18rpx;
  margin-top: 10rpx;
  border-radius: 50%;
  background: #9aa8b5;
}

.history-dot.normal {
  background: #24b989;
}

.history-dot.sitting {
  background: #f0a52d;
}

.history-dot.fall {
  background: #de3f4f;
}

.history-copy {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.history-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.history-status {
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.3;
}

.history-status.normal {
  color: #10846d;
}

.history-status.sitting {
  color: #96600a;
}

.history-status.fall {
  color: #ba2636;
}

.history-status.unknown {
  color: #53606b;
}

.history-time {
  flex-shrink: 0;
  margin-left: 14rpx;
  color: #7d9297;
  font-size: 22rpx;
  line-height: 1.3;
}

.history-detail {
  display: block;
  margin-top: 8rpx;
  color: #58747a;
  font-size: 24rpx;
  line-height: 1.4;
}

.care-card {
  margin-top: 28rpx;
  padding: 28rpx;
}

.care-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.care-title {
  color: #18383f;
  font-size: 30rpx;
  font-weight: 800;
}

.care-tag {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.care-tag.normal {
  background: #e0f7ef;
  color: #10846d;
}

.care-tag.sitting {
  background: #fff0cf;
  color: #96600a;
}

.care-tag.fall {
  background: #ffe2e3;
  color: #ba2636;
}

.care-tag.unknown {
  background: #e8edf1;
  color: #53606b;
}

.care-text {
  display: block;
  margin-top: 18rpx;
  color: #58747a;
  font-size: 27rpx;
  line-height: 1.65;
}

.alert-status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #f7faf9;
}

.alert-label {
  color: #6a858c;
  font-size: 23rpx;
  line-height: 1.3;
}

.alert-value {
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.3;
}

.alert-value.normal,
.alert-value.handled {
  color: #10846d;
}

.alert-value.sitting {
  color: #96600a;
}

.alert-value.fall {
  color: #ba2636;
}

.care-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 22rpx;
}

.care-action {
  flex: 1;
  height: 76rpx;
  border-radius: 18rpx;
  background: #e8f1f0;
  color: #24535a;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 76rpx;
  text-align: center;
}

.care-action.primary {
  background: #174a51;
  color: #ffffff;
}

.device-list {
  padding: 10rpx 26rpx;
}

.device-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(86, 134, 142, .12);
}

.device-item:last-child {
  border-bottom: 0;
}

.device-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
}

.device-dot.green {
  background: #24b989;
}

.device-dot.blue {
  background: #2c8fc9;
}

.device-dot.amber {
  background: #f0a52d;
}

.device-copy {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.device-name {
  color: #18383f;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.3;
}

.device-desc {
  margin-top: 6rpx;
}
